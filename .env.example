# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=invoice_reconciliation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# LLM provider: ollama (local) or gemini (remote)
LLM_PROVIDER=ollama
GEMINI_API_KEY=
# Optional overrides (empty = provider defaults: Ollama qwen2.5:7b /
# qwen3-embedding:0.6b@1024, or Gemini gemini-2.0-flash /
# gemini-embedding-2@1536)
CHAT_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIM=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_DIM=1024

# FastAPI
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
APP_DEBUG=true

# Langfuse (optional)
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_HOST=http://localhost:3000

# Agent Config
PRICE_DEVIATION_THRESHOLD=5.0
QUANTITY_MISMATCH_THRESHOLD=0.0

# File Upload
UPLOAD_DIR=uploads/invoices
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_CHARS=100000

# Auth (false = local-dev owner; true = Firebase / guest tokens)
AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
# Inline service-account JSON string, or set GOOGLE_APPLICATION_CREDENTIALS
FIREBASE_CREDENTIALS_JSON=
# For local emulator: set FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 in the environment
SECRET_KEY=dev-only-change-me
INACTIVE_ACCOUNT_DAYS=7
GUEST_RETENTION_HOURS=24
PDF_RETENTION_DAYS=7

# Demo (3 scenarios/day; set TRUST_PROXY_HEADER=true only behind Cloudflare)
DEMO_RUNS_PER_DAY=3
TRUST_PROXY_HEADER=false

# Rate limits / queue fairness
UPLOAD_RATE_PER_MINUTE=3
MAX_INFLIGHT_PER_USER=1
INFLIGHT_TTL_SECONDS=3600
PROVIDER_RPM_LIMIT=20
PROVIDER_RETRY_MAX=4

# Daily quota (charged at provider call; gate-rejected PDFs cost nothing)
DAILY_INVOICE_LIMIT_DEFAULT=15
GLOBAL_CHAT_DAILY_CAP=1000

# Quota increase Discord notify — set the real URL in .env only (never commit it)
DISCORD_WEBHOOK_URL=
